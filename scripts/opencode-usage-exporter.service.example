# systemd user unit para o exporter de uso das conexões do OpenCode
# Instalar em ~/.config/systemd/user/opencode-usage-exporter.service
#   cp scripts/opencode-usage-exporter.service.example ~/.config/systemd/user/opencode-usage-exporter.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now opencode-usage-exporter
# Abrir porta no firewall (se houver): ufw allow 9998/tcp

[Unit]
Description=Prometheus exporter de uso das conexões do OpenCode
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/homelab-grafana-dashboards/scripts/opencode_usage_exporter.py --port 9998
Environment=OPENCODE_USAGE_DISABLE_NET=0
Environment=OPENCODE_USAGE_REFRESH=300
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
{
  "uid": "cloud-ft-runpod",
  "title": "Cloud FT / RunPod",
  "description": "Fine-tune na nuvem: pod RunPod, progresso de treino, aprovação Telegram, download e benchmark.",
  "tags": [
    "cloud",
    "runpod",
    "finetune",
    "eddie"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Fase pipeline",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_phase",
          "refId": "A",
          "legendFormat": "{{phase}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "watching"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "training"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "3": {
                  "text": "pending_approval"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "4": {
                  "text": "downloading"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "5": {
                  "text": "benchmarking"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "6": {
                  "text": "done"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "7": {
                  "text": "rejected"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "8": {
                  "text": "error"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "purple",
                "value": 6
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Pod RUNNING",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_pod_running",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF",
                  "color": "red"
                },
                "1": {
                  "text": "ON",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Custo $/h",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 7,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_cost_per_hr_usd",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        }
      }
    },
    {
      "type": "stat",
      "title": "GPU util %",
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_gpu_util_pct",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 50
              },
              {
                "color": "orange",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "VRAM used",
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 13,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_gpu_mem_used_mib",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        }
      }
    },
    {
      "type": "stat",
      "title": "SSH OK",
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_ssh_ok",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO",
                  "color": "red"
                },
                "1": {
                  "text": "YES",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Train quality",
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_train_quality",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "max": 100,
          "decimals": 1
        }
      }
    },
    {
      "type": "timeseries",
      "title": "GPU util % e VRAM MiB",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_gpu_util_pct",
          "refId": "A",
          "legendFormat": "util %"
        },
        {
          "expr": "cloud_ft_gpu_mem_used_mib",
          "refId": "B",
          "legendFormat": "VRAM MiB"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Train loss",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_train_loss",
          "refId": "A",
          "legendFormat": "loss"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Progresso (step / %)",
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_train_step",
          "refId": "A",
          "legendFormat": "step"
        },
        {
          "expr": "cloud_ft_train_pct",
          "refId": "B",
          "legendFormat": "pct"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job status (0 pend 1 run 2 ok 3 fail)",
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_job_status",
          "refId": "A",
          "legendFormat": "{{ft_job}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Finished all",
      "id": 14,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_finished_all",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO"
                },
                "1": {
                  "text": "YES",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Download bytes",
      "id": 15,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_download_bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        }
      }
    },
    {
      "type": "stat",
      "title": "Metrics age s",
      "id": 16,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dfc0w4yioe4u8e"
      },
      "targets": [
        {
          "expr": "cloud_ft_metrics_age_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        }
      }
    },
    {
      "type": "text",
      "title": "Como usar",
      "id": 20,
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "options": {
        "mode": "markdown",
        "content": "**Fluxo:** treino no RunPod → `pending_approval` → botão Telegram (approval-gateway) → download → benchmark.\n\n**Fallback:** `echo approved > /var/lib/eddie/cloud_ft/approve_<session>`\n\n**Docs:** `docs/CLOUD_FT_RUNPOD.md`"
      }
    }
  ],
  "id": null,
  "version": 1
}
